# Copy this file to .env and fill it in.

# Password for the admin dashboard at /admin
ADMIN_PASSWORD=change-me
# Long random string used to sign admin logins (e.g. run: openssl rand -hex 32)
SESSION_SECRET=

# The public address of the shop, used for Hubtel's callback and return URLs.
# e.g. https://shop.example.com.gh
PUBLIC_URL=

# --- Hubtel Online Checkout ---
# From your Hubtel merchant dashboard (API keys section).
# If these are empty the shop runs in TEST mode with a pretend payment page
# (not available when NODE_ENV=production).
HUBTEL_API_ID=
HUBTEL_API_KEY=
# Your Hubtel merchant account number (POS Sales ID)
HUBTEL_MERCHANT_ACCOUNT=
# Optional but recommended: enables checking payment status with Hubtel before
# confirming an order. Usually the same as HUBTEL_MERCHANT_ACCOUNT. Hubtel
# must whitelist your server's IP address for this API.
HUBTEL_POS_SALES_ID=

PORT=3001
DATA_DIR=data
